{
    "name": "glue-agency/craft-elasticsearch",
    "description": "Index Craft Elements to Elasticsearch",
    "type": "craft-plugin",
    "license": "mit",
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "elasticsearch/elasticsearch": "^8.0",
        "guzzlehttp/guzzle": "^7.2.0",
        "insolita/yii2-array-structure-validator": "^2.0.0",
        "illuminate/collections": "^10.0||^11.0||^12.0"
    },
    "autoload": {
        "psr-4": {
            "GlueAgency\\Elasticsearch\\": "src/"
        }
    },
    "extra": {
        "handle": "elasticsearch",
        "name": "Elasticsearch",
        "developer": "Glue Agency",
        "documentationUrl": "",
        "class": "GlueAgency\\Elasticsearch\\Elasticsearch"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
